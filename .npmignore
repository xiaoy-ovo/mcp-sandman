# npm packaging is driven by the "files" field in package.json, so anything not
# listed there is excluded automatically. This file exists only to be explicit
# about the traps.

# The Rust sources are on GitHub, not needed to run the installed binary.
src/
fixtures/
scripts/
.github/
*.toml
Cargo.lock

# Test and dev artifacts
test/
scratch/
dist/
target/
node_modules/

# The downloaded binary is platform-specific and must never be committed into
# the published tarball; postinstall places it per-platform.
bin/mcp-sandman
bin/mcp-sandman.exe

# Keep these: they ship with the package.
!README.md
!LICENSE
!index.js
!index.d.ts
!package.json